{
  "name": "daterbase",
  "productName": "Daterbase",
  "version": "0.9.17",
  "private": true,
  "description": "Daterbase",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dist": "electron-builder",
    "start": "electron ."
  },
  "build": {
    "appId": "com.yeonkki.daterbase",
    "productName": "Daterbase",
    "files": [
      "dist/**",
      "dist-share/**",
      "electron/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Daterbase"
    },
    "publish": {
      "provider": "generic",
      "url": "https://github.com/daterbase/daterbase/releases/latest/download"
    }
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  },
  "devDependencies": {
    "electron": "43.7.9",
    "electron-builder": "25.1.8"
  },
  "author": "Daterbase"
}